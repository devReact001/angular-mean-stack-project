<!--
========================================
LOGIN COMPONENT TEMPLATE - COMPLETE GUIDE
========================================

This HTML file shows the login form UI.
It connects to login.component.ts through:
- Two-way binding: [(ngModel)]
- Event binding: (click), (submit)
- Property binding: [disabled]
- Structural directives: *ngIf

Think of this like filling out a form:
- Input fields = Where you write
- Button = When you submit
- Error message = If something went wrong
-->

<!-- ==========================================
     CONTAINER
     =========================================== -->

<!--
<div class="login-container">
  - Creates a box to contain everything
  - CSS class adds styling (border, padding, width)
  - Think of it as the "form container"
-->
<div class="login-container">

  <!-- ==========================================
       TITLE / HEADING
       =========================================== -->

  <!--
  <h1>Login</h1>

  - Shows "Login" as the page title
  - h1 = Heading level 1 (biggest)
  - Tells user what page they're on
  -->
  <h1>Login to Your Account</h1>

  <!-- ==========================================
       ERROR MESSAGE (Conditional)
       =========================================== -->

  <!--
  *ngIf="errorMessage"

  Structural directive that:
  1. Checks: Is errorMessage not empty?
  2. If YES: Show this div
  3. If NO: Hide this div

  IMPORTANT: The asterisk * means "remove/add DOM element"
  (Not just hide with CSS display:none)

  Example scenarios:
  - User enters wrong password
  - errorMessage = "Invalid email or password"
  - *ngIf="errorMessage" → true
  - Error div appears ✓

  - User hasn't tried login yet
  - errorMessage = ""
  - *ngIf="errorMessage" → false
  - Error div doesn't exist in DOM
  -->
  <div *ngIf="errorMessage" class="error-message">

    <!--
    {{ errorMessage }}

    Interpolation: Shows value of component property

    How it works:
    1. login.component.ts has: errorMessage: string = '';
    2. User tries to login with wrong password
    3. Component sets: this.errorMessage = "Invalid...";
    4. Template shows: {{ errorMessage }}
    5. User sees: "Invalid email or password" ✓

    Double curly braces {{ }} = "Show this value"
    -->
    {{ errorMessage }}

  </div>
  <!-- End error message div -->

  <!-- ==========================================
       LOGIN FORM
       =========================================== -->

  <!--
  <form (ngSubmit)="login()">

  (ngSubmit)="login()" = Event binding

  Triggers when:
  - User clicks submit button
  - User presses Enter in input field

  Calls: login() method in login.component.ts

  Alternative: Could use (click) on button instead
  But (ngSubmit) is better for forms
  -->
  <form (ngSubmit)="login()">

    <!-- ==========================================
         EMAIL INPUT FIELD
         =========================================== -->

    <!--
    <div class="form-group">

    Container for one input field
    Groups: label + input + error
    -->
    <div class="form-group">

      <!--
      <label>Email Address:</label>

      Label text telling user what to enter
      Clicking label focuses input field (better UX)

      Accessibility: Helps screen readers understand form
      -->
      <label for="email">Email Address:</label>

      <!--
      <input [(ngModel)]="email" name="email" type="email" />

      BREAKING THIS DOWN:

      [(ngModel)]="email"
      ├─ [( )] = Two-way binding
      ├─ () = Event binding (user types)
      ├─ [ ] = Property binding (component updates input)
      └─ "email" = Connect to component.email property

      What happens:
      1. User types in input → component.email updates
      2. Component changes email → input updates

      Example:
      User types "j" → email = "j"
      Keeps typing "ohn" → email = "john"
      User clears input → email = ""

      name="email"
      ├─ Required for [(ngModel)] in forms
      └─ Identifies this field to Angular

      type="email"
      ├─ HTML5 email validation
      ├─ Shows @ symbol on mobile keyboard
      └─ Browser might validate format

      placeholder="Enter your email"
      ├─ Hint text shown in empty input
      ├─ Helps user understand what to enter
      └─ Disappears when user starts typing

      required
      ├─ HTML5 validation
      ├─ Input can't be submitted empty
      └─ Shows browser error message
      -->
      <input
        [(ngModel)]="email"
        id="email"
        name="email"
        type="email"
        placeholder="Enter your email address"
        required
      />

      <!--
      TECHNICAL DEEP DIVE:

      Before:
      Component: email = "user@example.com"
      Input shows: "user@example.com"

      User types "z" at end:
      Event: (ngModelChange) fires
      Angular: Updates component.email = "user@example.com z"

      Component changes email:
      Property binding: Updates input.value
      Input shows: "user@example.com z"

      Result: Always in sync ✓
      -->

    </div>
    <!-- End email form group -->

    <!-- ==========================================
         PASSWORD INPUT FIELD
         =========================================== -->

    <!--
    Similar to email field, but password type
    -->
    <div class="form-group">

      <label for="password">Password:</label>

      <!--
      <input
        [(ngModel)]="password"
        name="password"
        type="password"
      />

      type="password"
      ├─ Hides characters (shows dots/asterisks)
      ├─ Security: So others can't see password
      └─ Essential for login forms

      Why two-way binding?
      ├─ User types password
      ├─ Component.password gets value
      ├─ login() method uses this.password
      └─ Component and input stay in sync

      SECURITY NOTE:
      ├─ value shown in component = Memory (fast)
      ├─ Not sent to server until form submits
      ├─ Backend receives it in HTTPS (encrypted)
      └─ Password hashed in database (never stored plaintext)
      -->
      <input
        [(ngModel)]="password"
        id="password"
        name="password"
        type="password"
        placeholder="Enter your password"
        required
      />

    </div>
    <!-- End password form group -->

    <!-- ==========================================
         SUBMIT BUTTON
         =========================================== -->

    <!--
    <button type="submit">

    type="submit"
    ├─ Submits form (triggers ngSubmit on <form>)
    ├─ Pressing Enter also submits
    └─ Semantic HTML (accessibility)
    -->
    <button
      type="submit"

      <!--
      [disabled]="isLoading"

      Property binding: Disables button

      When isLoading is true:
      - Button can't be clicked
      - Changes color (grayed out)
      - Cursor shows "not-allowed"
      - Prevents double-submissions

      Example:
      1. User clicks Login
      2. Component: isLoading = true
      3. Button disabled automatically ✓
      4. Request finishes
      5. Component: isLoading = false
      6. Button enabled again ✓

      Why disable?
      ├─ Prevent accidental double-clicks
      ├─ No multiple simultaneous requests
      ├─ Better UX (user knows it's processing)
      └─ Server doesn't get duplicate requests
      -->
      [disabled]="isLoading"
    >

      <!--
      {{ isLoading ? 'Logging in...' : 'Login' }}

      Ternary operator in template

      Syntax: condition ? true_value : false_value

      Example:
      isLoading = false → Shows "Login"
      isLoading = true → Shows "Logging in..."

      Real scenario:
      1. Button text: "Login"
      2. User clicks
      3. isLoading = true
      4. Button text changes to: "Logging in..."
      5. Button is also disabled (grayed out)
      6. User sees feedback ✓
      7. Request finishes
      8. isLoading = false
      9. Button text back to: "Login"
      10. Button enabled again

      User experience flow:
      Click → See "Logging in..." → Waits → Back to normal
      Much better than frozen button with no feedback!
      -->
      {{ isLoading ? 'Logging in...' : 'Login' }}

    </button>

  </form>
  <!-- End form -->

  <!-- ==========================================
       FOOTER / SIGNUP LINK
       =========================================== -->

  <!--
  <p>

  Paragraph with signup link
  "Don't have account? Click here"
  -->
  <p class="signup-link">

    <!--
    Don't have an account?

    Plain text, no special meaning
    Just informational text
    -->
    Don't have an account?

    <!--
    <a routerLink="/signup">Sign up here</a>

    routerLink="/signup"
    ├─ Angular router navigation
    ├─ Changes URL to /signup
    ├─ Loads SignupComponent
    └─ No full page reload (SPA behavior)

    How it works:
    1. User clicks "Sign up here"
    2. Angular router intercepts click
    3. Checks route config for /signup
    4. Finds SignupComponent
    5. Loads that component
    6. URL changes to localhost:4200/signup
    7. Page shows signup form

    Alternative to routerLink:
    - Could use [href]="/signup" (full page reload)
    - Could use (click)="router.navigate(['/signup'])"
    - But routerLink is cleanest

    Styling:
    ├─ <a> tag = Blue, underlined by default
    ├─ CSS can style: color, hover effects
    └─ Tells user it's clickable
    -->
    <a routerLink="/signup">Sign up here</a>

  </p>

</div>
<!-- End login container -->

<!-- ==========================================
     STRUCTURE SUMMARY
     =========================================== -->

<!--
Login Form Structure:

login-container (outer box)
├── h1 (title)
├── error-message (if errorMessage exists)
├── form (submission handler)
│   ├── form-group (email)
│   │   ├── label
│   │   └── input[type=email]
│   ├── form-group (password)
│   │   ├── label
│   │   └── input[type=password]
│   └── button[type=submit]
└── signup-link
    └── routerLink="/signup"
-->

<!-- ==========================================
     BINDING SUMMARY
     =========================================== -->

<!--
Two-way binding ([(ngModel)]):
- email input ↔↔ component.email
- password input ↔↔ component.password

Event binding ((ngSubmit)):
- form submission → login() method

Property binding ([disabled]):
- isLoading → button.disabled

String interpolation ({{ }}):
- errorMessage value in DOM
- Ternary operator for button text

Structural directives (*ngIf):
- Show/hide error message
- Show/hide elements based on conditions

Router directive (routerLink):
- Navigate to /signup without reload
-->

<!-- ==========================================
     TYPICAL LIFECYCLE
     =========================================== -->

<!--
1. PAGE LOADS
   - Template renders
   - errorMessage = "" (hidden)
   - email = "" (empty input)
   - password = "" (empty input)
   - isLoading = false (button enabled)
   - Button shows: "Login"

2. USER TYPES EMAIL
   - Clicks email input
   - Types: "user@"
   - Two-way binding: component.email = "user@"
   - Input shows: "user@"

3. USER TYPES PASSWORD
   - Clicks password input
   - Types: "password123"
   - Two-way binding: component.password = "password123"
   - Input shows: "..........." (hidden)

4. USER CLICKS LOGIN BUTTON
   - (ngSubmit)="login()" triggers
   - login() method runs
   - isLoading = true
   - Button disabled (grayed out)
   - Button text: "Logging in..."

5. REQUEST SENT TO BACKEND
   - HTTP POST to /api/auth/login
   - Body: { email: "user@...", password: "..." }
   - Waiting for response...

6a. SUCCESS - USER EXISTS & PASSWORD CORRECT
   - Backend responds: { token: "xyz...", user: {...} }
   - login() success callback runs
   - isLoading = false (handled in component)
   - Router navigates to /dashboard
   - Component destroyed
   - User sees dashboard

6b. ERROR - WRONG PASSWORD OR USER NOT FOUND
   - Backend responds: { error: "Invalid credentials" }
   - login() error callback runs
   - isLoading = false
   - errorMessage = "Invalid email or password"
   - Error message appears to user
   - password field cleared (security)
   - User can try again
-->

<!-- ==========================================
     ACCESSIBILITY NOTES
     =========================================== -->

<!--
Good accessibility features in this template:

1. Labels with "for" attribute
   <label for="email">Email:</label>
   <input id="email" />
   ✓ Links label to input
   ✓ Click label focuses input
   ✓ Screen readers understand relationship

2. Type="email" for email input
   ✓ Browser validation
   ✓ Mobile keyboard shows @ symbol
   ✓ Semantic HTML

3. Type="password" for password input
   ✓ Hidden characters for security
   ✓ Screen readers read as password

4. Required attribute
   <input required />
   ✓ Browser validation
   ✓ Can't submit empty form
   ✓ Screen readers announce required

5. Clear error messages
   {{ errorMessage }}
   ✓ User knows what went wrong
   ✓ Not just generic error
   ✓ Actionable ("try different password")

6. Disabled button state
   [disabled]="isLoading"
   ✓ User knows form is processing
   ✓ Can't submit twice
   ✓ Loading text shows progress
-->

<!-- ==========================================
     COMMON PATTERNS IN THIS TEMPLATE
     =========================================== -->

<!--
Pattern 1: Conditional rendering with *ngIf
<div *ngIf="condition">...</div>

Pattern 2: Two-way binding with [(ngModel)]
<input [(ngModel)]="property" />

Pattern 3: Event binding with (submit)
<form (ngSubmit)="method()">...</form>

Pattern 4: Property binding for disabled state
<button [disabled]="isLoading">...</button>

Pattern 5: String interpolation
<p>{{ propertyName }}</p>

Pattern 6: Ternary operator in template
{{ condition ? 'yes' : 'no' }}

Pattern 7: Router navigation with routerLink
<a routerLink="/path">Link</a>

All these patterns work together in real Angular apps!
-->
